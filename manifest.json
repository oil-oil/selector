{
  "manifest_version": 3,
  "name": "AI Element Picker for Claude & Codex",
  "version": "1.0.0",
  "description": "Visually select any DOM element and copy an AI prompt for Claude Code, Codex, Cursor, or Copilot. Vibe coding made easy.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AI Element Picker",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["assets/editor.js"],
    "css": ["assets/editor.css"],
    "run_at": "document_idle",
    "world": "MAIN"
  }]
}
